rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deliverables uploaded for projects: only authenticated users can access
    match /deliverables/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Payment receipts: only authenticated users can access
    match /receipts/{invoiceId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Profile avatars: only authenticated users can read, user can update own avatar
    match /profiles/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // General fallback
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
